{
    "packages": {
        ".": {
            "release-type": "simple",
            "bump-minor-pre-major": true,
            "initial-version": "0.1.0",
            "extra-files": [
                "src/octopus_openfeature_provider/_version.py",
                {
                    "type": "toml",
                    "path": "pyproject.toml",
                    "jsonpath": "$.project.version"
                },
                {
                    "type": "toml",
                    "path": "uv.lock",
                    "jsonpath": "$.package[?(@.name.value=='octopus-openfeature-provider')].version"
                }
            ]
        }
    }
}
